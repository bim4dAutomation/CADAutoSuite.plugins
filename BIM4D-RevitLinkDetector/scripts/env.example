# Copy this file to scripts/.env and fill in real values. scripts/.env is
# gitignored — never commit real credentials.
#
# Use a dedicated APS app (Client ID/Secret) for this, ideally scoped to
# a single project, not a personal/shared one.

APS_CLIENT_ID=
APS_CLIENT_SECRET=

# No separate nickname to set here: appbundle-register.js/.py register
# everything under your APS_CLIENT_ID itself (Autodesk's "nickname" is just
# a mnemonic stand-in for the Client ID - see
# https://aps.autodesk.com/en/docs/design-automation/v3/tutorials/revit/step3-create-nickname).
# BIM4D-BE's .env must use this same APS_CLIENT_ID/APS_CLIENT_SECRET pair so
# its Activity IDs resolve against the same account.
