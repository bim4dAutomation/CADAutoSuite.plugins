<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!--
  Revit add-in manifest for Design Automation.

  This file is NOT installed into a user's %AppData%\Autodesk\Revit\Addins
  folder — that's how a normal desktop Revit add-in gets loaded. Instead,
  for Design Automation, this .addin file is packaged INSIDE the AppBundle
  zip (see bundle/RevitLinkDetector.bundle/PackageContents.xml, which
  points a Revit-engine ComponentEntry at this file via ModuleName), and
  the cloud Revit engine loads it from there. Keep it next to
  RevitLinkDetector.dll in the bundle's Contents folder.
-->
<RevitAddIns>
  <AddIn Type="DBApplication">
    <Name>RevitLinkDetector</Name>
    <Assembly>./RevitLinkDetector.dll</Assembly>
    <!--
      Must be unique among add-ins loaded in the same Revit session. This
      GUID is fixed for this add-in — do not regenerate it once registered,
      since nothing outside this file depends on matching it exactly, but
      keeping it stable avoids confusion across rebuilds.
    -->
    <AddInId>3f7f9b8a-1b7e-4e2f-9c7d-5b6a8e2d4c90</AddInId>
    <FullClassName>Bim4D.RevitLinkDetector.App</FullClassName>
    <VendorId>CADAUTOSUITE</VendorId>
    <VendorDescription>CAD Auto Suite BIM4D</VendorDescription>
  </AddIn>
</RevitAddIns>
