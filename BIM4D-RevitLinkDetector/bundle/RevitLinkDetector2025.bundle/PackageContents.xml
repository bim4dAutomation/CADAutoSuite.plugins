<?xml version="1.0" encoding="utf-8"?>
<!--
  Design Automation AppBundle manifest for Revit 2025. Must sit at the
  ROOT of RevitLinkDetector2025.bundle/, with the 2025-built DLL,
  RevitLinkDetector.addin, and Newtonsoft.Json.dll inside this folder's
  Contents/. scripts/pack-bundle.ps1 -RevitYear 2025 lays this out and
  zips it into the shape APS's AppBundle upload expects.

  SeriesMin/SeriesMax below target the Revit 2025 engine specifically -
  see scripts/revit-versions.json for the target framework and any
  caveats for this year (2026 and 2027 both have open notes there).
-->
<ApplicationPackage
    Name="RevitLinkDetector2025"
    Description="Reads a Revit 2025 host file's saved link references (TransmissionData) and reports them as JSON, without opening the document."
    Author="BIM4D Automation"
    AppVersion="1.0.0"
    FriendlyVersion="1.0.0"
    HelpFile=""
    ProductType="Application"
    AutodeskProduct="Revit"
    SchemaVersion="1.0"
    SupportedOS="Win64">
  <CompanyDetails Name="BIM4D Automation" Email="bim4dautomation@gmail.com" />
  <Components Description="RevitLinkDetector Design Automation add-in (Revit 2025)">
    <RuntimeRequirements SeriesMax="R2025" SeriesMin="R2025" Platform="Revit" OS="Win64" />
    <ComponentEntry
        AppName="RevitLinkDetector2025"
        Version="1.0.0"
        ModuleName="./Contents/RevitLinkDetector.addin"
        AppDescription="Reads Revit link references headlessly via TransmissionData."
        LoadOnRevitStartup="True" />
  </Components>
</ApplicationPackage>
